generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String @id      @default(uuid())
  spotifyUserId       String @unique
  accountName         String
  spotifyAccessToken  String
  spotifyRefreshToken String
  expiryDate          DateTime
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}